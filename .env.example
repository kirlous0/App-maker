# ==============================================
# Repo2APK Environment Variables
# Copy this file to .env.local for local dev
# ==============================================

# Public application URL (used for OAuth callbacks & webhook docs)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase Configuration (PostgreSQL + Private Storage)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Server-Side Cryptography (generate with: openssl rand -hex 32)
SESSION_SECRET=replace-with-64-hex-characters-for-session-hmac
TOKEN_ENCRYPTION_KEY=replace-with-64-hex-characters-for-aes-256-gcm

# GitHub App Configuration (required for real GitHub auth & builds)
GITHUB_APP_ID=123456
GITHUB_APP_SLUG=your-repo2apk-github-app
GITHUB_CLIENT_ID=Iv23xxxxxxxxxxxx
GITHUB_CLIENT_SECRET=your-github-app-client-secret
GITHUB_APP_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"
GITHUB_WEBHOOK_SECRET=replace-with-webhook-secret

# Background Job & Security Policies
CRON_SECRET=replace-with-cron-secret
BUILD_TIMEOUT_MINUTES=45
MAX_CONCURRENT_BUILDS_PER_USER=2
ARTIFACT_RETENTION_DAYS=7
